{
  "name": "montador-enem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run sync:database && vite",
    "build": "npm run sync:database && npm run clean:pages && vite build",
    "preview": "vite preview",
    "sync:database": "node scripts/sync-database.mjs",
    "build:database": "node scripts/build-database.mjs",
    "localize:images": "node scripts/localize-question-images.mjs",
    "extract:years": "node scripts/extract-enem-years.mjs",
    "import:years": "node scripts/import-extracted-years.mjs",
    "enrich:inep": "node scripts/enrich-inep.mjs",
    "enrich:inep:2023": "node scripts/enrich-inep.mjs --years 2023 --verbose",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "clean:pages": "node scripts/clean-pages.mjs",
    "audit:inep": "node scripts/enrich-inep.mjs --dry-run --safe-min-coverage 0.93 --report-json ../data/inep/audit/latest.json --report-md ../data/inep/audit/latest.md --verbose"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.2.6",
    "jquery": "^3.7.1",
    "jszip": "^3.10.1",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^7.1.5"
  }
}
